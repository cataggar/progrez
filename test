#!/usr/bin/env bash

set -uo pipefail

FAILURES=0

zig_command=(zig)
if command -v nix >/dev/null 2>&1; then
	zig_command=(nix develop -c zig)
fi

echo "=== Unit and C ABI tests ==="
if "${zig_command[@]}" build -j2 test "$@"; then
	echo "PASS: unit and C ABI tests"
else
	echo "FAIL: unit and C ABI tests"
	((FAILURES++))
fi

echo ""
echo "=== Building demo for CLI tests ==="
if "${zig_command[@]}" build -j2 "$@" 2>&1; then
	echo "PASS: build"
else
	echo "FAIL: build"
	((FAILURES++))
fi

echo ""
echo "=== CLI integration tests ==="
if bash tests/cli/test_cli.sh 2>&1; then
	echo "PASS: CLI tests"
else
	echo "FAIL: CLI tests"
	((FAILURES++))
fi

if [ "$FAILURES" -gt 0 ]; then
	echo ""
	echo "FAILED: $FAILURES suite(s)"
	exit "$FAILURES"
fi

echo ""
echo "ALL TESTS PASSED"
